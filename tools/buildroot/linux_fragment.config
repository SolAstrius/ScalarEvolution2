# Linux kernel config fragment for Scalar Evolution's in-game RV64 VM.
#
# Applied on top of Buildroot 2026.02's qemu_riscv64_virt_defconfig via
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES. Tuned for RVVM's emulated
# devices: simple-framebuffer, I2C HID keyboard/mouse, C-Media HDA codec.

# -- Framebuffer + fbcon --------------------------------------------------
# Render kernel messages onto RVVM's simple-framebuffer DTB node so the
# in-game workstation screen lights up during boot.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# -- USB HID + evdev ------------------------------------------------------
# Not strictly needed for RVVM's I2C HID path (see below), but keeps the
# USB stack functional for any future USB device experiments.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB=y
CONFIG_USB_HID=y
CONFIG_USB_XHCI_HCD=y
CONFIG_INPUT_EVDEV=y

# -- DRM disabled (intentional) -------------------------------------------
# qemu_riscv64_virt_defconfig enables CONFIG_DRM=m. The I2C HID Kconfig has:
#   config I2C_HID_CORE
#       tristate
#       depends on DRM || !DRM
# so DRM=m pins I2C_HID_CORE=m — and in an initramfs-only kernel we have
# no modprobe at boot, so the driver never loads and RVVM's I2C HID
# keyboard stays invisible to the guest. We don't use DRM (simple-
# framebuffer is not a DRM device), so drop it to free I2C_HID_CORE=y.
# CONFIG_DRM is not set

# -- I2C HID --------------------------------------------------------------
# RVVM's hid_keyboard_init_auto / hid_mouse_init_auto attach the HID
# devices via I2C, not USB. librvvm emits a device-tree node with
# compatible = "hid-over-i2c"; the kernel's i2c-hid-of driver matches
# that, feeds reports into the input layer, and the VT console picks
# them up. Without these, typing looks like it does nothing.
#
# NOTE: CONFIG_I2C_HID is a menu-heading only in Linux 6.x+. The real
# driver is CONFIG_I2C_HID_CORE; I2C_HID_OF `select`s CORE. Both must be
# =y (built-in) — =m gives us a module in an initramfs with no modprobe
# at boot.
CONFIG_I2C=y
# RVVM uses the OpenCores I2C controller (compatible = "opencores,i2c-ocores")
# as the bus that HID keyboard/mouse hang off. Without this driver the
# I2C bus itself never probes — so even with I2C_HID_OF=y the HID device
# underneath is never enumerated and keypresses silently dropped.
CONFIG_I2C_OCORES=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_OF=y

# -- Serial console (NS16550A fallback) -----------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# -- Early boot + devfs ---------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
# devtmpfs so getty finds its tty without manual mknod.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# -- Sound (HDA) ----------------------------------------------------------
# RVVM's sound-hda.c emulates a C-Media CM8888 HDA controller. Use the
# Intel HDA controller driver plus the generic codec parser (CM8888 has
# no dedicated codec driver in mainline Linux, but SND_HDA_GENERIC
# covers the standard Audio Output widget graph).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_PREALLOC_SIZE=64
# Trim: no USB sound cards, no OSS emulation — keeps the image small.
# CONFIG_SND_USB is not set
