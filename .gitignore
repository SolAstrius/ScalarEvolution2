# Gradle
.gradle/
build/
src/generated/
out/
classes/

# OpenH264 ships its platform Makefiles in vendor/openh264/build/ — keep
# that tracked despite the global `build/` rule above.
!vendor/openh264/build/
!vendor/openh264/build/**

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# OS
.DS_Store
Thumbs.db

# Java
*.class
*.log
hs_err_pid*

# Eclipse
.apt_generated
.factorypath

# Run directory
run/
runs/
logs/
crash-reports/

# Buildroot output (artefacts are committed under src/main/resources/assets/scev/firmware/)
build-output/

# Nix / direnv
.direnv/

# Agent / working notes
AGENTS.md
README.md
docs/
.claude/

# Dev-only audio test material
*.mp3
*.wav
src/main/resources/assets/scev/firmware/alpine_rootfs.img

# Built natives — produced fresh by CI per platform and dropped into the
# classifier dirs. Never committed. (History was scrubbed of stale prebuilt
# librvvm blobs; do not re-add.)
src/main/resources/natives/*/librvvm.so
src/main/resources/natives/*/librvvm.dylib
src/main/resources/natives/*/librvvm.dll
src/main/resources/natives/*/librvvm.a
src/main/resources/natives/*/rvvm.dll
src/main/resources/natives/*/libscev_h264.so
src/main/resources/natives/*/libscev_h264.dylib
src/main/resources/natives/*/scev_h264.dll
src/main/resources/natives/*/libscev_term.so
src/main/resources/natives/*/libscev_term.dylib
src/main/resources/natives/*/scev_term.dll
src/main/resources/natives/*/mlterm-libexec/

# OpenH264 + JNI wrapper build intermediates. We vendor the OpenH264 source
# under vendor/openh264/ and build it in-place via its own Makefile; the
# build writes .o/.d/.a next to each source file. Keep the vendor tree
# clean of those outputs.
vendor/openh264/**/*.o
vendor/openh264/**/*.d
vendor/openh264/libopenh264.a
vendor/openh264/libopenh264.so*
vendor/openh264/libopenh264.dylib
native/openh264-jni/*.o
native/openh264-jni/*.d
native/openh264-jni/libscev_h264.*
native/openh264-jni/scev_h264.dll

# mlterm-jni build intermediates. Source lives in
# SolAstrius/mlterm-fb-embed (see PORT_PLAN.md); JNI shim is here.
native/mlterm-jni/*.o
native/mlterm-jni/*.d
native/mlterm-jni/libscev_term.*
native/mlterm-jni/scev_term.dll
native/mlterm-jni/regis_test
native/mlterm-jni/regis_test.o
native/mlterm-jni/scev_smoke
native/mlterm-jni/scev_term.smoke.o
src/main/resources/scev/mlterm-fonts/.mlterm/
